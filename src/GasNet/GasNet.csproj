<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- netstandard2.1: Unity (Mono/IL2CPP) 与 Godot 4 C# 可直接加载；net10.0: 桌面/服务器与本项目内的 Sample/Demo/Tests -->
    <TargetFrameworks>netstandard2.1;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>GasNet</RootNamespace>
    <AssemblyName>GasNet</AssemblyName>
    <Description>C# port of Unreal Engine's Gameplay Ability System (GAS) semantics, per GASDocumentation. Engine-agnostic (Unity / Godot ready).</Description>
  </PropertyGroup>

</Project>
