<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.1;net10.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>GasNet.Data</RootNamespace>
    <Description>Data-driven GameplayEffect definitions (JSON) for GasNet. Kept in a separate assembly so the core library stays dependency-free.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\GasNet\GasNet.csproj" />
  </ItemGroup>

  <!-- net10.0 has System.Text.Json in-box; only netstandard2.1 (Unity/Godot consumers) needs the package. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.1'">
    <PackageReference Include="System.Text.Json" Version="9.0.8" />
  </ItemGroup>

</Project>
