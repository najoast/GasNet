<!DOCTYPE html>
<html lang="zh-CN">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>GasNet Editor</title>
    <base href="/" />
    <link rel="stylesheet" href="app.css" />
    <script>
        // 夜间模式：必须在首帧绘制前把 data-theme 挂到 <html>（localStorage 记忆，缺省跟随系统），
        // 并暴露 gasTheme.isDark/toggle 给 Blazor 互操作。
        (function () {
            var KEY = "gasnet.theme";
            var theme = localStorage.getItem(KEY);
            if (theme !== "dark" && theme !== "light")
                theme = matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
            document.documentElement.dataset.theme = theme;
            window.gasTheme = {
                isDark: function () { return document.documentElement.dataset.theme === "dark"; },
                toggle: function () {
                    theme = theme === "dark" ? "light" : "dark";
                    document.documentElement.dataset.theme = theme;
                    localStorage.setItem(KEY, theme);
                    return theme;
                },
            };
            // 未保存守卫：Blazor 在有未保存修改时调用 gasDirty.set(true)。
            window.gasDirty = {
                set: function (dirty) { document.body.dataset.dirty = dirty ? "1" : "0"; },
            };
            window.addEventListener("beforeunload", function (e) {
                if (document.body.dataset.dirty === "1") {
                    e.preventDefault();
                    e.returnValue = "";
                }
            });
        })();
    </script>
    <HeadOutlet @rendermode="InteractiveServer" />
</head>

<body>
    <Routes @rendermode="InteractiveServer" />
    <script src="_framework/blazor.web.js"></script>
</body>

</html>
